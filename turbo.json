{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "BETTER_AUTH_SECRET",
        "DATABASE_URL",
        "DATABASE_NAME",
        "CORS_ORIGIN",
        "ADMIN_ALLOWED_EMAILS",
        "BETTER_AUTH_URL",
        "PRIVY_APP_ID",
        "PRIVY_APP_SECRET",
        "PRIVY_JWT_VERIFICATION_KEY"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
