{
  "extends": "@rdm-hack/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "../..",
    "types": ["bun", "node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": [
    "api",
    "src",
    "../../packages/api/src",
    "../../packages/auth/src",
    "../../packages/blockchain-client/*.json",
    "../../packages/blockchain-client/src",
    "../../packages/db/src",
    "../../packages/env/src"
  ]
}
